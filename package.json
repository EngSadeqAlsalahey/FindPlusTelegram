{
  "name": "findpulse",
  "version": "1.0.0",
  "private": true,
  "description": "FindPulse - search engine over a curated directory of public Telegram channels and groups",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bot": "tsx --env-file-if-exists=.env src/bot/index.ts",
    "bot:dev": "tsx watch --env-file-if-exists=.env src/bot/index.ts",
    "check:bot": "tsx --env-file-if-exists=.env scripts/check-bot.ts",
    "check:catalog": "tsx scripts/validate-catalog.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
